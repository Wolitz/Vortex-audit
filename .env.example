# Copy to .env and fill in. Every variable here is required at runtime.

# --- Database (Postgres) ---
DATABASE_URL=
DIRECT_URL=

# --- Auth ---
# Generate with: openssl rand -base64 32
# There is no fallback: the app refuses to start a session without this.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Public app URL (Stripe redirects and portal return) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Audit engine ---
GEMINI_API_KEY=
# Optional: override the default model (gemini-2.5-flash)
# GEMINI_MODEL=

# --- Video storage ---
BLOB_READ_WRITE_TOKEN=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_ID=
STRIPE_PRICE_PRO_ID=
STRIPE_PRICE_MAX_ID=
